# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Editors / IDEs
.idea/
.vscode/
*.swp
*.swo

# Build / distribution outputs
dist/
build/

# Harness export outputs (scripts/export_harness_package.py)
dist/harnesses/

# Logs and temp
*.log
*.tmp
tmp/
tmp-test/
scratch/

# Workflow layer (selective tracking)
# /AGENTS.md 는 2026-08-18 에 추적으로 전환했다 (TASK-2026-08-18-main-001).
# 이 저장소의 Codex 진입점이 여기 살고, 워크플로우 규칙 블록을 additive 로 싣는다.
# 추적하지 않던 동안 check_docs·check_self_application 이 **로컬에서만** red 라
# 전량 검사 때마다 파일을 손으로 비켜 둬야 했다 (CI 는 파일이 없어 green).
/ANTIGRAVITY.md

# Exclude duplicated engine/tool copies in the source repo
/ai-workflow/scripts/
/ai-workflow/skills/
/ai-workflow/workflow_kit/
/ai-workflow/mcp_servers/
/ai-workflow/schemas/
/ai-workflow/templates/
/ai-workflow/examples/
/ai-workflow/global-snippets/
/ai-workflow/harnesses/
/ai-workflow/tests/

# Keep the data (memory) and core guides
!/ai-workflow/README.md
!/ai-workflow/WORKFLOW_INDEX.md
!/ai-workflow/core/
!/ai-workflow/memory/

# v0.6.0+: LLM wiki layer (Runtime, git-tracked, durable knowledge)
# See .omo/plans/v0.5.11-plus-llm-wiki-distributed-rules.md#s3-3-gitignore-policy
!/ai-workflow/wiki/
!/ai-workflow/wiki/**/*.md

# Local tooling (not tracked)
.mavis/
ai-workflow/wiki/.obsidian/

# Project-local Codex / oh-my-codex installation
.agents/
.omx/
.codex/config.toml
.codex/prompts/

# mkdocs build output
/site/

# v0.7.62+ consumer_metrics history (append-only snapshot log, runtime-generated)
**/.consumer_metrics_history.jsonl

# v0.13.1+ memory_index telemetry sidecar (append-only retrieval events, runtime-generated)
**/memory_index/telemetry/events.jsonl

# v0.8.x workflow-source build venv (build-time only, not runtime)
workflow-source/.venv-build/

# 로컬 SDK 매트릭스 venv (workflow_kit.common.sdk_matrix --run-local)
/.venv-sdk-matrix/

# Claude Code worktree isolation (harness-internal)
.claude/worktrees/

# 내장 git worktree (에이전트 별도 checkout) — 이 트리의 인덱스에 넣지 않는다
.worktrees/
