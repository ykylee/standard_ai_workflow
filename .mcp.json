{
  "mcpServers": {
    "standardAiWorkflowReadOnly": {
      "args": [
        "-m",
        "workflow_kit.server.read_only_jsonrpc",
        "--stdio-lines",
        "--bundle",
        "read-only"
      ],
      "command": "python3",
      "env": {
        "PYTHONPATH": "workflow-source",
        "STANDARD_AI_WORKFLOW_ROOT": "."
      },
      "type": "stdio"
    },
    "standardAiWorkflowWrite": {
      "args": [
        "-m",
        "workflow_kit.server.read_only_jsonrpc",
        "--stdio-lines",
        "--bundle",
        "write"
      ],
      "command": "python3",
      "env": {
        "PYTHONPATH": "workflow-source",
        "STANDARD_AI_WORKFLOW_ROOT": "."
      },
      "type": "stdio"
    },
    "workflow-hub": {
      "headers": {
        "Authorization": "Bearer ${WORKFLOW_HUB_TOKEN}"
      },
      "type": "http",
      "url": "https://homelab.ddn777.synology.me/workflow/mcp"
    }
  }
}
